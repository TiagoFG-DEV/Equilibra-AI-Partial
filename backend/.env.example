GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# API PRÓPRIA / SERVIÇO CUSTOMIZADO (PADRÃO OPENAI COMPATÍVEL)
CUSTOM_API_KEY=sua_chave_custom_se_houver
CUSTOM_BASE_URL=http://localhost:8000/v1
CUSTOM_CHAT_MODEL=custom-model-rh

# OPENAI
OPENAI_API_KEY=
