# ==============================================================================
# EQUILIBRA IA - AMBIENTE DE CONFIGURAÇÃO (backend/.env.example)
# ==============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

AI_PROVIDER=groq

# GROQ
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# API PRÓPRIA / SERVIÇO CUSTOMIZADO (PADRÃO OPENAI COMPATÍVEL)
CUSTOM_API_KEY=sua_chave_custom_se_houver
CUSTOM_BASE_URL=http://localhost:8000/v1
CUSTOM_CHAT_MODEL=custom-model-rh

# OPENAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# GEMINI
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# OLLAMA
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2

SKILLS_DIR=../skills
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=equilibra_meta_webhook_token_2026
WHATSAPP_API_VERSION=v20.0
JWT_SECRET=equilibra_rh_secret_key_super_segura_nr1_2026
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://model:model@localhost:5432/model?schema=public
REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Relativo ao diretório backend, independentemente de onde o comando é executado.
SURVEY_ROOT=../skills
# Uma chave para integração simples OU API_CLIENTS_JSON para vários projetos.
SURVEY_API_KEY=
# Exemplo (não reutilize estes valores): {"equilibra":"<segredo-de-32-ou-mais-caracteres>","outro-projeto":"<outro-segredo-distinto>"}
API_CLIENTS_JSON=
# Produção: caminho absoluto no volume persistente; Render: /var/data/survey
SURVEY_OUTPUT_DIR=
# file: desenvolvimento/disco pago; postgres: banco externo, sem disco local.
SURVEY_STORAGE=file
# URL privada de PostgreSQL externo; em hosts remotos o TLS valida certificados.
SURVEY_DATABASE_URL=
TRUST_PROXY_HOPS=0
# Em produção é false por padrão. Mesmo true continua restrito ao loopback.
WHATSAPP_PAIRING_ENABLED=false
SURVEY_ENCRYPTION_KEY=
SURVEY_MIN_GROUP=5
SURVEY_ALLOW_DEMO=false
