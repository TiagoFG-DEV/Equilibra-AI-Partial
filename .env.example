# ==============================================================================
# EQUILIBRA IA - AMBIENTE DE CONFIGURAÇÃO (.env)
# Gestão Contínua de Riscos Psicossociais (NR-1) & Conformidade LGPD
# ==============================================================================

# --- AMBIENTE E SERVIDOR ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500

# --- SELEÇÃO DO PROVEDOR DE IA ---
# Opções suportadas: "groq" | "custom" | "openai" | "gemini" | "ollama"
# Padrão recomendado para alta velocidade e testes: groq
AI_PROVIDER=groq

# --- GROQ (PADRÃO PARA VELOCIDADE E BAIXA LATÊNCIA) ---
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Outros modelos Groq válidos: llama-3.1-8b-instant, mixtral-8x7b-32768

# --- API PRÓPRIA / SERVIDOR CUSTOMIZADO (COMPATÍVEL COM PADRÃO OPENAI) ---
# Utilize para testar APIs criadas internamente (FastAPI, vLLM, Ollama remoto, etc.)
CUSTOM_API_KEY=sua_chave_custom_se_houver
CUSTOM_BASE_URL=http://localhost:8000/v1
CUSTOM_CHAT_MODEL=custom-model-rh

# --- OPENAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- GOOGLE GEMINI ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# --- OLLAMA (EXECUÇÃO 100% LOCAL / OFFLINE) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2

# --- DIRETÓRIO DE SKILLS / PERSONAS ---
SKILLS_DIR=../skills

# --- WHATSAPP BUSINESS CLOUD API (META OFICIAL) ---
# Necessário para envio e recebimento real de mensagens pelo WhatsApp (Graph API)
# Obtenha em: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=equilibra_meta_webhook_token_2026
WHATSAPP_API_VERSION=v20.0

# --- SEGURANÇA E SESSÃO JWT ---
JWT_SECRET=equilibra_rh_secret_key_super_segura_nr1_2026
JWT_EXPIRES_IN=7d

# --- BANCO DE DADOS (POSTGRESQL - Opcional no modo simulação de IA) ---
DATABASE_URL=postgresql://model:model@localhost:5432/model?schema=public

# --- REDIS (CACHE / RATE LIMIT - Opcional, se vazio usa memória local) ---
REDIS_URL=

# --- LIMITES DE REQUISIÇÃO (RATE LIMIT) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
