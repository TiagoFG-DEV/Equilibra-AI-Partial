# Backend
NODE_ENV=development
PORT=4000

# PostgreSQL (obrigatório) — alinhar user/senha/db com o teu Postgres
DATABASE_URL=postgresql://model:model@localhost:5432/model?schema=public

# Redis (opcional) — rate limit distribuído; vazio = memória no Node
REDIS_URL=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173

SKILLS_DIR=../skills

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Gemini (Recomendado para busca na web nativa)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
