{
  "name": "model-chatbot-platform",
  "private": true,
  "version": "0.1.0",
  "description": "MODEL — base reutilizável para chatbots especializados (SaaS-ready)",
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "test": "npm run test -w backend",
    "build": "npm run build -w @model/core && npm run build -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:push": "npm run db:push -w backend",
    "db:studio": "npm run db:studio -w backend"
  },
  "engines": {
    "node": ">=20"
  }
}
